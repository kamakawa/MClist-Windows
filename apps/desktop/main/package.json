{
  "name": "mclist-desktop",
  "version": "1.1.0",
  "main": "main.js",
  "type": "commonjs",
  "author": {
    "name": "Eric Kamakawa",
    "email": "erickamakawa@hotmail.com"
  },
  "homepage": "https://github.com/erickamakawa/MClist",
  "description": "MClist",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:renderer": "npm --prefix ../renderer run build",
    "prepare:packaged-assets": "node ./scripts/prepare-packaged-assets.js",
    "build:backend:win": "powershell -ExecutionPolicy Bypass -File ..\\..\\..\\backend\\scripts\\build-release-windows.ps1",
    "dist:win": "npm run build:renderer && npm run build:backend:win && npm run prepare:packaged-assets && electron-builder --win nsis portable",
    "dist:dir": "npm run build:renderer && npm run prepare:packaged-assets && electron-builder --dir",
    "pack": "npm run dist:win"
  },
  "dependencies": {
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mclist.desktop",
    "productName": "MClist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/renderer-dist",
        "to": "renderer-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "artifactName": "MClist-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
